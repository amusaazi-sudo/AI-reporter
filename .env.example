# Copy this file to .env and replace the placeholders with your own values.
# Never commit your real .env file.

# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=PLEASE_FILL_YOUR_OPENROUTER_API_KEY

# NewsAPI key (only needed for news_summary reports): https://newsapi.org/register
NEWS_API_KEY=PLEASE_FILL_YOUR_NEWS_API_KEY

# Gmail account used to send the reports
GMAIL_ADDRESS=PLEASE_FILL_YOUR_GMAIL_ADDRESS

# Gmail App Password (not your normal password): https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=PLEASE_FILL_YOUR_GMAIL_APP_PASSWORD
